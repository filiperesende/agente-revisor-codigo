# Copie este arquivo para .env e preencha com a sua chave real.
# O arquivo .env NÃO é versionado (está no .gitignore).
#
# Sem chave, o agente funciona em modo MOCK (análise heurística).
# Com a chave, ele usa o Google Gemini para a análise.

# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# URL do webhook do Discord para notificação do resultado da revisão.
# Opcional: se ficar vazio, a etapa de notificação é pulada sem erro.
# Formato: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
